# Database.
#   Local development: the SQLite file below, no token needed.
#   Vercel: your Turso database, e.g. libsql://avenor-yourname.turso.io
DATABASE_URL="file:./prisma/dev.db"
# Turso auth token (only for a libsql:// database).
TURSO_AUTH_TOKEN=""

# Vercel Blob read-write token for car photo uploads. Vercel adds it
# automatically when you connect a Blob store to the project. Leave empty
# locally: photos are then saved to the uploads/ folder.
BLOB_READ_WRITE_TOKEN=""

# Dealer WhatsApp number that receives car inquiries, digits only
# with country code, e.g. 79991234567. Leave empty to only save to DB.
WHATSAPP_PHONE=""
